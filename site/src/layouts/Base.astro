---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'ocli — The Office CLI',
  description = 'Bridge GitHub Copilot, Claude Code, and Codex to the enterprise tools your org runs. Structured JSON access to Jira, Bitbucket, Confluence, SonarQube, and more.',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth bg-cream">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/ocli/favicon.png" />
    <meta name="color-scheme" content="light dark" />
    <!--
      Resolve the theme before first paint so there is no flash of the wrong
      palette. Runs synchronously in <head>, ahead of any body content.
      Precedence: explicit user choice (localStorage) → OS preference → light.
    -->
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('ocli-theme');
          const theme = stored === 'dark' || stored === 'light'
            ? stored
            : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.dataset.theme = theme;
        } catch {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-cream text-ink font-sans">
    <Nav />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
